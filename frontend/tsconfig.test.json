// <app> - test-program typecheck (vitest units + architecture). Extends the
// build tsconfig; src and tests are checked as one program so the tests see
// the same types the app ships.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
