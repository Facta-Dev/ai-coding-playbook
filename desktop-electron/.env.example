# <app> — local environment (gitignored once copied to .env).
#
# Copy to .env and fill in what you need. Only non-secret, main-process
# settings belong here; the <APP>_ prefix keeps the app's variables out of
# other tooling's namespace. After scripts/rename.sh, <APP> becomes the
# app's uppercase slug.
#
# Never put a secret here: values in this file end up readable by the main
# process (and, through it, in diagnostic logs).
#
# Log level: trace | debug | info | warn | error
# <APP>_LOG_LEVEL=info
#
# Base URL of the backend API (no trailing slash)
# <APP>_API_BASE_URL=https://api.example.invalid
#
# Force GPU safe mode (CPU rendering, no accelerated compositing)
# <APP>_HARDWARE_ACCELERATION=off
